# ============================================================
# BRIGHTLOOP SMS — Environment Variables Example
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Database ---
DATABASE_URL="postgresql://sms_user:CHANGE_ME@localhost:5432/brightloop_sms"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- API ---
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development

# --- JWT / Sessions ---
JWT_SECRET=CHANGE_ME_at_least_64_random_chars
JWT_EXPIRY=15m
REFRESH_TOKEN_SECRET=CHANGE_ME_at_least_64_random_chars
REFRESH_TOKEN_EXPIRY=7d
SESSION_SECRET=CHANGE_ME_at_least_64_random_chars

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGE_ME_at_least_32_random_chars

# --- Email (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@brightloop.com
SMTP_PASS=CHANGE_ME
EMAIL_FROM="Brightloop <no-reply@brightloop.com>"

# --- Object Storage (S3-compatible) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME
STORAGE_BUCKET=brightloop-invoices
STORAGE_REGION=us-east-1

# --- App ---
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Rate Limiting ---
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# --- Password Reset ---
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
