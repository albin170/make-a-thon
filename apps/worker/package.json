{
  "name": "@brightloop/worker",
  "version": "1.0.0",
  "description": "Brightloop SMS — BullMQ standalone worker process",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.540.0",
    "@prisma/client": "^5.11.0",
    "bullmq": "^5.4.2",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "nodemailer": "^6.9.12",
    "pdfkit": "^0.14.0",
    "winston": "^3.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.14",
    "@types/nodemailer": "^6.4.14",
    "@types/pdfkit": "^0.13.3",
    "prisma": "^5.11.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "tsconfig": {
    "extends": "../../tsconfig.base.json"
  }
}
